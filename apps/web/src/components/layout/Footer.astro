---
import ThemeToggle from '../islands/ThemeToggle';
import { FOOTER_PRIMARY, FOOTER_SECONDARY } from '../../lib/nav';
import { person } from '../../data/eden';
const year = new Date().getFullYear();
---
<footer class="ftr">
  <div class="ds-wrap">
    <div class="ftr__row">
      <nav class="ftr__links" aria-label="Footer">
        {FOOTER_PRIMARY.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
      <div class="ftr__profiles">
        {FOOTER_SECONDARY.map((p, i) => (
          <>
            {i > 0 && <span aria-hidden="true">·</span>}
            <a href={p.href} target="_blank" rel="me noopener noreferrer">{p.label}</a>
          </>
        ))}
      </div>
    </div>
    <div class="ftr__row ftr__row--meta">
      <span>© {year} {person.name} · {person.location}</span>
      <div class="ftr__meta"><span>Languages · images · ideas</span><ThemeToggle client:visible /></div>
    </div>
  </div>
</footer>

<style>
  .ftr { margin-top: auto; border-top: 1px solid rgb(var(--hairline)); padding-block: 28px 32px; font-size: 13px; }
  .ftr__row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px 28px; }
  .ftr__row--meta { margin-top: 18px; padding-top: 16px; border-top: 1px solid rgb(var(--hairline)); }
  .ftr__links { display: flex; flex-wrap: wrap; gap: 4px 18px; }
  .ftr a { color: rgb(var(--text-muted)); text-decoration: none; display: inline-flex; align-items: center; min-height: 32px; }
  .ftr a:hover { color: rgb(var(--text)); }
  .ftr__links--secondary a { color: rgb(var(--text-faint)); }
  .ftr__profiles { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; color: rgb(var(--text-faint)); }
  .ftr__meta { display: flex; align-items: center; gap: 14px; color: rgb(var(--text-faint)); }
  @media (max-width: 720px) {
    .ftr__row { flex-direction: column; align-items: flex-start; }
    .ftr__links { gap: 0 16px; }
    .ftr a { min-height: 40px; }
  }
</style>
