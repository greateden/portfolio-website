---
/**
 * The skewed-band hero: a yellow block at -14deg on the right with an 8px
 * blue strip on its edge and a photo clipped into it. Text sits left.
 * Below 720px the band + photo stack ABOVE the headline (Home Phone).
 *
 * Slots: default = text column · `aside` = content set on the yellow
 * (big number) · `strip` = bottom-right ink strip ("Next up …").
 * The optional giant faded word ("Faris") sits behind everything.
 */
import SanityImg from './SanityImg.astro';
import type { SanityImage } from '../../lib/sanity/v3';
import type { PortfolioPhoto } from '../../data/photography/collection';

interface Props {
  image?: SanityImage | null;
  /** A direct image URL for an independent portfolio without a Sanity dataset. */
  imageSrc?: string;
  /** Optional curated Flickr collection. Enables the homepage photo selector. */
  slides?: PortfolioPhoto[];
  /** Up to three photos: first spans the top, two below (the mosaic). */
  mosaic?: (SanityImage | null | undefined)[];
  imageAlt?: string;
  /** Fallback object-position when the photo has no hotspot, e.g. "50% 30%". */
  focus?: string;
  /** Desktop height in px (auto on phone). */
  height?: number;
  /** Width of the yellow block (the photo is 8% narrower). */
  bandWidth?: number;
  giant?: string;
  /** Loading priority: the hero photo is the LCP element. */
  priority?: boolean;
  class?: string;
}

const { image, imageSrc, slides = [], mosaic, imageAlt, focus = '50% 30%', height = 520, bandWidth = 50, giant, priority = true, class: className } = Astro.props;
const photos = (mosaic ?? []).filter((p): p is SanityImage => Boolean(p?.asset));
const hasPhoto = Boolean(imageSrc || image?.asset) || photos.length > 0;
const vars = `--hero-h:${height}px;--band-w:${bandWidth}%;--photo-w:${bandWidth - 8}%;--focus:${focus}`;
const hasAside = Astro.slots.has('aside');
---

<section class:list={['skh', { 'skh--photo': hasPhoto, 'skh--aside': hasAside }, className]} style={vars}
  data-photo-gallery={slides.length > 1 ? JSON.stringify(slides) : undefined}>
  {giant && <div class="skh__giant" aria-hidden="true">{giant}</div>}
  <div class="skh__art" aria-hidden={hasPhoto ? undefined : 'true'}>
    <div class="skh__band"></div>
    <div class="skh__edge"></div>
    {photos.length > 1 ? (
      <div class="skh__photo skh__mosaic">
        {photos.slice(0, 3).map((p, i) => (
          <SanityImg image={p} ratio={i === 0 ? 16 / 9 : 1} widths={i === 0 ? [640, 960, 1280] : [360, 600]} sizes={i === 0 ? '(max-width: 720px) 100vw, 46vw' : '(max-width: 720px) 50vw, 23vw'} loading={priority ? 'eager' : 'lazy'} fetchpriority={i === 0 && priority ? 'high' : undefined} class:list={['skh__img', { 'skh__img--wide': i === 0 }]} />
        ))}
      </div>
    ) : hasPhoto ? (
      <div class="skh__photo">
        {imageSrc ? (
          <img src={imageSrc} alt={imageAlt || ''} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} class="skh__img" data-hero-slide={slides.length > 1 ? 'true' : undefined} />
        ) : <SanityImg image={image ?? photos[0]} alt={imageAlt} widths={[640, 960, 1400]} sizes="(max-width: 720px) 100vw, 42vw" loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} class="skh__img" />}
      </div>
    ) : null}
    {hasAside && <div class="skh__aside"><slot name="aside" /></div>}
    {slides.length > 1 && (
      <div class="skh__photo-controls" role="group" aria-label="Browse the featured photographs">
        <button type="button" data-hero-prev aria-label="Previous photograph" title="Previous photograph">←</button>
        <output class="skh__photo-count" data-hero-count aria-live="polite">01 / {String(slides.length).padStart(2, '0')}</output>
        <button type="button" data-hero-next aria-label="Next photograph" title="Next photograph">→</button>
        <a href={slides[0].href} data-hero-source target="_blank" rel="noopener noreferrer" aria-label="Open the featured photograph on Flickr">Flickr ↗</a>
      </div>
    )}
  </div>
  <div class="ds-wrap skh__text">
    <div class="skh__col"><slot /></div>
  </div>
  {Astro.slots.has('strip') && <div class="skh__strip"><slot name="strip" /></div>}
</section>

<style>
  .skh { position: relative; overflow: hidden; min-height: var(--hero-h); display: flex; align-items: flex-start; }
  .skh__giant {
    position: absolute; left: -30px; top: -80px; font-weight: 900; font-size: 540px; line-height: 0.8; letter-spacing: -0.07em;
    color: rgb(var(--text)); opacity: 0.035; white-space: nowrap; pointer-events: none; user-select: none;
  }
  .skh__art { position: absolute; inset: 0; pointer-events: none; }
  .skh__band, .skh__edge { position: absolute; top: 0; bottom: 0; transform: skewX(var(--skew)); transform-origin: top; }
  .skh__band { right: -8%; width: var(--band-w); background: rgb(var(--yellow)); }
  .skh__edge { right: calc(var(--photo-w) - 4px); width: 8px; background: rgb(var(--blue)); }
  .skh__photo { position: absolute; right: 0; top: 0; bottom: 0; width: var(--photo-w); clip-path: polygon(18% 0, 100% 0, 100% 100%, 0 100%); pointer-events: auto; }
  .skh__photo :global(.skh__img) { width: 100%; height: 100%; object-fit: cover; object-position: var(--fp, var(--focus)); display: block; }
  .skh__mosaic { display: grid; grid-template-columns: 1.2fr 1fr; grid-template-rows: 1.15fr 1fr; gap: 6px; background: rgb(var(--ground)); clip-path: polygon(16% 0, 100% 0, 100% 100%, 0 100%); width: calc(var(--photo-w) + 4%); }
  .skh__mosaic :global(.skh__img--wide) { grid-column: 1 / -1; }
  .skh__aside { position: absolute; right: var(--gutter); bottom: 48px; width: min(320px, calc(var(--band-w) - 14%)); color: rgb(var(--c-ink)); pointer-events: auto; }
  .skh__text { position: relative; z-index: 1; padding-top: 60px; padding-bottom: 60px; }
  .skh__col { display: flex; flex-direction: column; gap: 22px; max-width: min(520px, calc(100% - var(--band-w) - 2%)); }
  .skh__strip { position: absolute; right: 0; bottom: 0; z-index: 2; }

  @media (max-width: 900px) {
    .skh__col { max-width: min(460px, 54%); }
  }
  @media (max-width: 720px) {
    .skh { flex-direction: column; min-height: 0; }
    .skh__giant { font-size: 300px; top: -40px; }
    .skh__art { position: relative; inset: auto; height: 250px; width: 100%; flex: none; }
    .skh--aside .skh__art { height: 210px; }
    .skh__band { right: -14%; width: 72%; }
    .skh__edge { right: calc(58% - 4px); }
    .skh__photo, .skh__mosaic { width: 58%; }
    .skh__aside { right: var(--gutter); bottom: 20px; width: 50%; }
    .skh__text { padding-top: 24px; padding-bottom: 36px; }
    .skh__col { max-width: none; gap: 18px; }
    .skh__strip { position: relative; width: 100%; }
  }

  /* Avoid a flash of the server-rendered fallback before the random photo loads.
     Without JavaScript the fallback remains visible. */
  :global(html.js) .skh[data-photo-gallery] .skh__photo img { opacity: 0; transition: opacity .28s ease; }
  :global(html.js) .skh[data-photo-gallery] .skh__photo img.is-ready { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .skh[data-photo-gallery] .skh__photo img { transition: none; }
  }

  /* Original skewed hero remains intact; only its photo gets a small selector. */
  .skh__photo-controls {
    position: absolute; z-index: 4; bottom: 18px; right: 20px;
    display: flex; gap: 7px; align-items: center; pointer-events: auto;
    padding: 7px; background: rgb(var(--c-ink) / .88); color: rgb(var(--c-cream));
    border: 1px solid rgb(var(--c-cream) / .28); border-radius: var(--radius-card);
    backdrop-filter: blur(9px);
  }
  .skh__photo-controls button { width: 36px; height: 36px; border-radius: 2px;
    border: 1px solid rgb(var(--c-cream) / .3); color: inherit; background: transparent;
    font-size: 19px; line-height: 1; cursor: pointer; }
  .skh__photo-controls button:hover { background: rgb(var(--yellow)); color: rgb(var(--c-ink)); border-color: transparent; }
  .skh__photo-count { min-width: 52px; text-align: center; font-size: 12px; font-variant-numeric: tabular-nums; }
  .skh__photo-controls a { color: inherit; font-size: 12px; text-decoration: none; margin: 0 8px; }
  .skh__photo-controls a:hover { text-decoration: underline; text-decoration-color: rgb(var(--yellow)); }
  @media (max-width: 720px) {
    .skh__photo-controls { right: 10px; bottom: 10px; }
    .skh__photo-controls button { width: 33px; height: 33px; }
  }
</style>

<script>
  import type { PortfolioPhoto } from '../../data/photography/collection';

  /** Random on full load, with no immediate repeat in this browser tab. */
  function initialisePhotoHeroes() {
    document.querySelectorAll<HTMLElement>('[data-photo-gallery]').forEach((section) => {
      if (section.dataset.galleryReady === '1') return;
      const image = section.querySelector<HTMLImageElement>('[data-hero-slide]');
      const previous = section.querySelector<HTMLButtonElement>('[data-hero-prev]');
      const next = section.querySelector<HTMLButtonElement>('[data-hero-next]');
      const counter = section.querySelector<HTMLOutputElement>('[data-hero-count]');
      const source = section.querySelector<HTMLAnchorElement>('[data-hero-source]');
      if (!image || !previous || !next || !counter || !source) return;

      let items: PortfolioPhoto[] = [];
      try { items = JSON.parse(section.dataset.photoGallery || '[]') as PortfolioPhoto[]; }
      catch { return; }
      if (items.length < 2) return;
      section.dataset.galleryReady = '1';

      const storageKey = 'eden.hero.last-photo-id';
      let previousId = '';
      try { previousId = sessionStorage.getItem(storageKey) || ''; } catch { /* private browsing */ }
      let chosen = Math.floor(Math.random() * items.length);
      if (items[chosen]?.id === previousId) {
        chosen = (chosen + 1 + Math.floor(Math.random() * (items.length - 1))) % items.length;
      }
      let current = chosen;
      let failedLoads = 0;

      function display(index: number) {
        current = (index + items.length) % items.length;
        const photo = items[current];
        if (image.getAttribute('src') !== photo.src) {
          image.classList.remove('is-ready');
          image.src = photo.src;
        }
        if (image.complete && image.naturalWidth > 0) image.classList.add('is-ready');
        image.alt = photo.alt;
        source.href = photo.href;
        source.setAttribute('aria-label', 'Open ' + photo.caption + ' on Flickr');
        counter.textContent = String(current + 1).padStart(2, '0') + ' / ' + String(items.length).padStart(2, '0');
        try { sessionStorage.setItem(storageKey, photo.id); } catch { /* private browsing */ }
      }
      image.addEventListener('load', () => image.classList.add('is-ready'));
      display(chosen);
      previous.addEventListener('click', () => { failedLoads = 0; display(current - 1); });
      next.addEventListener('click', () => { failedLoads = 0; display(current + 1); });

      // A horizontal touch swipe changes the image. Normal vertical scrolling is untouched.
      const surface = section.querySelector<HTMLElement>('.skh__photo');
      let touchX = 0, touchY = 0;
      surface?.addEventListener('touchstart', (event) => {
        touchX = event.changedTouches[0]?.clientX ?? 0;
        touchY = event.changedTouches[0]?.clientY ?? 0;
      }, { passive: true });
      surface?.addEventListener('touchend', (event) => {
        const dx = (event.changedTouches[0]?.clientX ?? touchX) - touchX;
        const dy = (event.changedTouches[0]?.clientY ?? touchY) - touchY;
        if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy) * 1.4) {
          failedLoads = 0;
          display(current + (dx < 0 ? 1 : -1));
        }
      }, { passive: true });
      section.addEventListener('keydown', (event) => {
        if (!(event.target instanceof HTMLElement) || !event.target.closest('.skh__photo-controls')) return;
        if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
          event.preventDefault();
          failedLoads = 0;
          display(current + (event.key === 'ArrowRight' ? 1 : -1));
        }
      });
      image.addEventListener('error', () => {
        // Flickr may revoke individual CDN URLs. Try the remaining entries only once.
        if (failedLoads++ < items.length - 1) display(current + 1);
      });
    });
  }
  initialisePhotoHeroes();
  document.addEventListener('astro:page-load', initialisePhotoHeroes);
</script>
