---
import BaseLayout from '../layouts/BaseLayout.astro';
import Kicker from '../components/v3/Kicker.astro';
const links = [
  { label:'Home', href:'/', note:'A place to begin' },
  { label:'Photography', href:'/gallery', note:'The visual journal' },
  { label:'Projects', href:'/projects', note:'Research and making' },
  { label:'Contact', href:'/contact', note:'Start a conversation' },
];
---
<BaseLayout title="Page not found · 404" noindex>
  <div class="ds-wrap nf">
    <div>
      <Kicker parts={['Error','404']} mutedFirst />
      <p class="nf__num" aria-hidden="true">404</p>
      <h1 class="ds-h1">Wrong turn.</h1>
      <p class="ds-lede">Sometimes the most interesting way forward is a different path.</p>
      <a href="/" class="ds-btn ds-btn--yellow">Back home</a>
    </div>
    <nav aria-label="Where to go next">
      {links.map(l => <a class="nf__row" href={l.href}><strong>{l.label}</strong><span>{l.note}</span><span aria-hidden="true">↗</span></a>)}
    </nav>
  </div>
</BaseLayout>
<style>
  .nf {display:grid;grid-template-columns:1fr 1fr;gap:60px;padding-block:72px;}
  .nf>div{display:flex;flex-direction:column;align-items:flex-start;gap:20px;}
  .nf__num{font-size:clamp(110px,17vw,210px);font-weight:900;line-height:.85;color:rgb(var(--accent-text));letter-spacing:-.08em;margin:0;}
  .nf nav{align-self:end;}
  .nf__row{display:grid;grid-template-columns:1fr 1fr auto;gap:12px;align-items:center;border-top:1px solid rgb(var(--hairline));padding:18px 0;text-decoration:none;}
  .nf__row strong{font-size:21px;}.nf__row span{color:rgb(var(--text-muted));font-size:14px;}
  .nf__row:hover strong{color:rgb(var(--accent-text));}
  @media(max-width:800px){.nf{grid-template-columns:1fr;gap:38px;padding-block:42px;}.nf nav{align-self:stretch;}}
</style>
