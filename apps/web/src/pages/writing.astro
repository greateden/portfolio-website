---
import BaseLayout from '../layouts/BaseLayout.astro';
import SkewHero from '../components/v3/SkewHero.astro';
import Kicker from '../components/v3/Kicker.astro';
import { photos } from '../data/eden';
const notes = [
  { tag: 'Comparative poetics · in progress', title: 'Weather inside the poem', body: 'A cross-cultural exploration of storms, longing and freedom in poetry and song.' },
  { tag: 'Personal notebook · in progress', title: 'An atlas of things almost said', body: 'On language, perception and the moments too fleeting to classify.' },
  { tag: 'Language and identity · an ongoing question', title: 'What survives translation?', body: 'Thoughts that grow out of studying languages, rather than a published article.' },
];
---
<BaseLayout title="Writing" band={false} description="An evolving writing desk of research questions and literary interests by Eden Li Yitian.">
  <SkewHero imageSrc={photos[0].src} imageAlt={photos[0].alt} giant="Words" height={500}>
    <Kicker parts={['Writing', 'Notebook']} />
    <h1 class="ds-h1">The things almost said.</h1>
    <p class="ds-lede">Language is an instrument of precision, and sometimes of beautiful uncertainty.</p>
  </SkewHero>
  <section class="ds-wrap ds-section writing">
    <div>
      <p class="ds-kicker">The writing desk</p>
      <h2 class="ds-h2 ds-h2--sm">Notes and questions.</h2>
      <p class="writing__disclaimer">These are themes I am working on, not a catalogue of published articles.</p>
    </div>
    <div class="writing__list">
      {notes.map((note,i) => (
        <article class:list={['writing__note', { 'writing__note--blue': i%2 === 1 }]}>
          <span class="ds-kicker">{note.tag}</span>
          <h3>{note.title}</h3>
          <p>{note.body}</p>
        </article>
      ))}
      <a href="/contact" class="ds-link ds-link--sm">Start a conversation</a>
    </div>
  </section>
</BaseLayout>
<style>
  .writing { display:grid; grid-template-columns: minmax(0,1fr) minmax(0,1.3fr); gap:50px; }
  .writing h2 { margin-top:12px; }
  .writing__disclaimer { max-width:32ch; font-size:15px; color:rgb(var(--text-muted)); margin-top:18px; }
  .writing__list { display:flex; flex-direction:column; }
  .writing__note { position:relative; padding:22px 24px; border-top:1px solid rgb(var(--hairline)); display:flex; flex-direction:column; gap:10px; }
  .writing__note::before{content:'';position:absolute;left:0;top:22px;bottom:22px;width:8px;border-radius:3px;background:repeating-linear-gradient(to bottom,rgb(var(--yellow)) 0 10px,transparent 10px 16px);}
  .writing__note--blue::before{background:repeating-linear-gradient(to bottom,rgb(var(--blue)) 0 10px,transparent 10px 16px);}
  .writing__note h3{font-size:clamp(22px,2.6vw,29px);letter-spacing:-.04em;line-height:1.08;}
  .writing__note p{font-size:15px;color:rgb(var(--text-muted));margin:0;}
  .writing__list>.ds-link{margin-top:22px;align-self:flex-start;}
  @media(max-width:720px){.writing{grid-template-columns:1fr;gap:24px;}}
</style>
