---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SkewHero from '../../components/v3/SkewHero.astro';
import Kicker from '../../components/v3/Kicker.astro';
import PosterCard from '../../components/v3/PosterCard.astro';
import { person, photos, projects } from '../../data/eden';
---
<BaseLayout title="Projects" band={false} description="Eden Li Yitian's research and creative projects in speech, languages, cartography and human-computer interaction.">
  <SkewHero imageSrc={photos[0].src} imageAlt={photos[0].alt} giant="Work" height={500}>
    <Kicker parts={['Work', 'Research & making']} />
    <h1 class="ds-h1">Questions in progress.</h1>
    <p class="ds-lede">An unfinished atlas of languages, machines, maps and metaphors.</p>
  </SkewHero>
  <section class="ds-wrap ds-section">
    <div class="projects__intro">
      <p class="ds-kicker">Selected projects</p>
      <h2 class="ds-h2 ds-h2--sm">Work that connects the seemingly unrelated.</h2>
      <p class="ds-body">Some projects are published. Others are experiments or research still taking shape. I distinguish the two.</p>
    </div>
    <div class="projects__grid">
      {projects.map((p, i) => (
        <article class="projects__card" id={'work-' + p.number}>
          <div class="projects__poster">
            <PosterCard n={i + 1} tone={i === 0 ? 'lead' : 'ink'} kicker={p.category} title={p.title}
              text={p.subtitle} href={p.href || '/contact'} external={Boolean(p.href)}
              action={p.href ? 'Open public repository' : 'Ask me about this'} />
          </div>
          <div class="projects__details">
            <p>{p.description}</p>
            <div class="projects__meta">
              <span>{p.details}</span>
              <strong>{p.status}</strong>
            </div>
          </div>
        </article>
      ))}
    </div>
    <p class="projects__foot">More work is taking shape. The public code lives on <a href={person.github} target="_blank" rel="me noopener noreferrer">GitHub ↗</a>.</p>
  </section>
</BaseLayout>
<style>
  .projects__intro { display: flex; flex-direction: column; gap: 14px; margin-bottom: 30px; max-width: 620px; }
  .projects__grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 18px; }
  .projects__card { display: flex; flex-direction: column; min-width: 0; scroll-margin-top: 28px; }
  .projects__poster :global(.poster) { min-height: 290px; }
  .projects__details { padding: 20px 8px 30px; display: flex; flex-direction: column; gap: 16px; }
  .projects__details p { margin: 0; font-size: 15.5px; line-height: 1.6; color: rgb(var(--text-muted)); }
  .projects__meta { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; padding-top: 12px; border-top: 1px solid rgb(var(--hairline)); font-size: 12px; }
  .projects__meta span { color: rgb(var(--text-faint)); }
  .projects__meta strong { color: rgb(var(--accent-text)); }
  .projects__foot { margin: 28px 0 0; font-size: 15px; }
  .projects__foot a { text-decoration: underline; text-decoration-color: rgb(var(--yellow)); }
  @media(max-width:720px){ .projects__grid{grid-template-columns:1fr;} }
</style>
