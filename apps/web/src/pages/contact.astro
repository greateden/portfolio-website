---
import BaseLayout from '../layouts/BaseLayout.astro';
import SkewHero from '../components/v3/SkewHero.astro';
import Kicker from '../components/v3/Kicker.astro';
import InvitePanel from '../components/v3/InvitePanel.astro';
import { person, photos } from '../data/eden';
const links = [
  { label: 'LinkedIn', href: person.linkedin, note: 'A professional conversation' },
  { label: 'Flickr', href: person.flickr, note: 'The photographic journal' },
  { label: 'GitHub', href: person.github, note: 'Public code and projects' },
];
---
<BaseLayout title="Contact" band={false} description="Get in touch with Eden Li Yitian through LinkedIn, Flickr or GitHub.">
  <SkewHero imageSrc={photos[1].src} imageAlt={photos[1].alt} height={490} giant="Hello">
    <Kicker parts={['Contact', 'Elsewhere']} />
    <h1 class="ds-h1">A conversation begins somewhere.</h1>
    <p class="ds-lede">I'm always curious to meet someone who sees a question from another angle.</p>
  </SkewHero>
  <section class="ds-wrap ds-section contact">
    <div class="contact__intro">
      <p class="ds-kicker">Say hello</p>
      <h2 class="ds-h2">What are you working on?</h2>
      <p class="ds-body">Language technology, photography, poetry or something that doesn't quite fit any category. For now, LinkedIn is the best place to reach me directly.</p>
      <div class="contact__links">
        {links.map(link => (
          <a href={link.href} class="contact__link" target="_blank" rel="me noopener noreferrer">
            <span><strong>{link.label}</strong><small>{link.note}</small></span><span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
    <InvitePanel
      kicker="A different kind of invitation"
      headline="Have a little improbable idea?"
      body="Good collaborations often begin with a question rather than a proposal."
      primary={{label:'Write to me on LinkedIn', href:person.linkedin}}
      secondary={{label:'Explore my photographs', href:person.flickr}}
      art="none"
    />
  </section>
</BaseLayout>
<style>
  .contact{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start;}
  .contact__intro{display:flex;flex-direction:column;gap:16px;}
  .contact__intro>.ds-body{max-width:44ch;}
  .contact__links{margin-top:14px;}
  .contact__link{display:flex;justify-content:space-between;align-items:center;gap:14px;text-decoration:none;padding:16px 0;border-top:1px solid rgb(var(--hairline));}
  .contact__link span:first-child{display:flex;flex-direction:column;gap:4px;}
  .contact__link strong{font-size:21px;letter-spacing:-.03em;}
  .contact__link small{font-size:13px;color:rgb(var(--text-muted));}
  .contact__link:hover strong{color:rgb(var(--accent-text));}
  @media(max-width:800px){.contact{grid-template-columns:1fr;gap:36px;}}
</style>
