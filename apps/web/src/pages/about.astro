---
import BaseLayout from '../layouts/BaseLayout.astro';
import SkewHero from '../components/v3/SkewHero.astro';
import Kicker from '../components/v3/Kicker.astro';
import { person, photos } from '../data/eden';
---
<BaseLayout title="About" band={false} description="Eden Li Yitian: language, photography and the distance between the measurable and the felt.">
  <SkewHero imageSrc={photos[2].src} imageAlt={photos[2].alt} giant="Eden" height={510}>
    <Kicker parts={['About', 'Eden Li Yitian']} />
    <h1 class="ds-h1">There is more than one way to see.</h1>
    <p class="ds-lede">I work where the precision of science meets the ambiguity of art.</p>
  </SkewHero>
  <div class="ds-wrap about">
    <article class="about__story">
      <h2 class="ds-h2 ds-h2--sm">A little about me.</h2>
      <p>My name is Eden. I'm studying Computational Linguistics and Language Technology at the University of Zurich, after studying Computer Science, French and German at the University of Otago in New Zealand.</p>
      <p>I am fascinated by the relationship between language and belonging: the things people say, the things machines misunderstand and the cultural worlds hiding inside seemingly ordinary words.</p>
      <p>My work moves between speech technology, French wordplay, minority-language accessibility and experimental software. Outside research, I photograph, read and write poetry and follow unfamiliar paths through cities and landscapes.</p>
      <p>I don't see these as competing interests. A line of poetry and a line of code both ask us to notice a pattern, and to decide what it might mean.</p>
      <h2 class="ds-h2 ds-h2--sm">A life in several languages.</h2>
      <p>Chinese, English, French and German have each changed how I understand the world. I am learning to listen more carefully to the languages around me in Switzerland, including Romansh and Swiss German.</p>
      <p>For me, language is never only information. It is memory, music and a way of recognising someone else.</p>
      <a href="/projects" class="ds-link">What I'm working on</a>
    </article>
    <aside class="about__aside">
      <div class="ds-panel about__panel">
        <p class="ds-kicker">In short</p>
        <h2 class="ds-h2 ds-h2--sm">Eden Li Yitian.</h2>
        <p>Computational linguist · photographer · writer</p>
        <dl>
          <div><dt>Based in</dt><dd>Zürich, Switzerland</dd></div>
          <div><dt>Studying</dt><dd>MSc Computational Linguistics and Language Technology · UZH</dd></div>
          <div><dt>Earlier</dt><dd>Computer Science, French and German · University of Otago</dd></div>
          <div><dt>Curious about</dt><dd>Speech, languages, photography, poetry and the spaces between them</dd></div>
        </dl>
        <a href={person.linkedin} class="ds-link ds-link--sm" target="_blank" rel="me noopener noreferrer">LinkedIn ↗</a>
      </div>
      <a href={photos[2].href} target="_blank" rel="noopener noreferrer" class="about__photo"><img src={photos[2].src} alt={photos[2].alt} loading="lazy" /><span>From the photographic journal · Flickr ↗</span></a>
    </aside>
  </div>
</BaseLayout>
<style>
  .about { display: grid; grid-template-columns: minmax(0, 680px) minmax(280px, 1fr); gap: 56px; padding-block: 64px; align-items: start; }
  .about__story { display: flex; flex-direction: column; gap: 26px; min-width: 0; }
  .about__story p { margin: 0; font-size: 18px; line-height: 1.7; color: rgb(var(--text)); }
  .about__story :global(.ds-link) { align-self:flex-start; }
  .about__aside { display: flex; flex-direction: column; gap: 18px; }
  .about__panel { display: flex; flex-direction: column; gap: 18px; padding: 28px; }
  .about__panel p { margin: 0; }
  .about__panel dl { display: grid; gap: 14px; margin: 0; }
  .about__panel dl div { padding-top: 14px; border-top: 1px solid rgb(var(--hairline)); }
  .about__panel dt { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .12em; color: rgb(var(--text-faint)); }
  .about__panel dd { margin: 5px 0 0; font-size: 15px; }
  .about__photo { text-decoration: none; color: rgb(var(--text-muted)); font-size: 12px; }
  .about__photo img { aspect-ratio: 1.3; object-fit: cover; width: 100%; border-radius: var(--radius-card); margin-bottom: 8px; }
  @media(max-width: 960px){.about{grid-template-columns:1fr;gap:36px;padding-block:42px;}.about__story{max-width:680px;}.about__story p{font-size:17px;}}
</style>
