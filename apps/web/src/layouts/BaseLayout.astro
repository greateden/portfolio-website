---
/** Uses the original site's design system, animated drawer, transitions and typography. */
import { ClientRouter } from 'astro:transitions';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { person } from '../data/eden';
import '../styles/global.css';
import '../styles/tokens.css';
import '../styles/ds.css';
import '@fontsource-variable/figtree';
import figtreeLatin from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
interface Props {
  title: string;
  description?: string;
  band?: boolean;
  noindex?: boolean;
}
const {
  title,
  description = person.description,
  band = true,
  noindex = false,
} = Astro.props;
const fullTitle = title === 'Home' ? person.name : title + ' | ' + person.name;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0F0F10" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F8F4EB" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <link rel="preload" href={figtreeLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/eden-favicon.svg" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="About this site" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'Person',
      name: person.name, description: person.description,
      homeLocation: { '@type': 'Place', name: person.location },
      sameAs: [person.flickr, person.linkedin, person.github],
    })} />
    <ClientRouter />

    <!-- Keep the original dark/light preference and navigation behaviour. -->
    <script is:inline>
      (() => {
        function applyTheme() {
          const root = document.documentElement;
          root.classList.add('js');
          let stored = null;
          try { stored = localStorage.getItem('theme') || localStorage.getItem('faziz-theme'); } catch {}
          const theme = stored === 'light' ? 'light' : 'dark';
          root.classList.toggle('dark', theme === 'dark');
          root.setAttribute('data-theme', theme);
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
    <!-- Retain the source site's reveal system and its visibility failsafe. -->
    <script is:inline>
      (() => {
        function initReveals() {
          const els = document.querySelectorAll('.ds-reveal');
          if (!els.length) return;
          els.forEach(el => el.classList.remove('in'));
          const io = new IntersectionObserver(entries => entries.forEach(e => {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          }), { threshold: 0.12 });
          els.forEach(el => io.observe(el));
          window.setTimeout(() => document.querySelectorAll('.ds-reveal:not(.in)').forEach(el => el.classList.add('in')), 600);
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initReveals, { once: true });
        } else initReveals();
        document.addEventListener('astro:after-swap', initReveals);
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="skip-link">Skip to content</a>
    <Header band={band} introEnabled={true} bio={person.bio} />
    <main id="main" class="flex-1"><slot /></main>
    <Footer />
  </body>
</html>
